{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:5001"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR-DEPLOYED-BACKEND-URL-HERE.com"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://YOUR-DEPLOYED-BACKEND-URL-HERE.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
