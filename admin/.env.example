# Next.js Admin Dashboard Environment Variables

# Supabase Public Configuration (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NEXT_PUBLIC_ENVIRONMENT=development

# --- PRODUCTION DEPLOYMENT ---
# When deploying to Vercel, set the following:
# NEXT_PUBLIC_API_URL=https://your-deployed-backend-url.com
# NEXT_PUBLIC_APP_URL=https://your-deployed-admin-url.vercel.app
# NEXT_PUBLIC_ENVIRONMENT=production
