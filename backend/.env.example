# Environment Configuration
NODE_ENV=development
PORT=5000

# Database - Optional if connecting directly without Supabase client
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nudgify_dev

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# IMPORTANT: The service role key is required for bypassing RLS and creating buckets.
# Get this from Supabase Dashboard -> Project Settings -> API -> service_role secret
# Do NOT use the anon key here.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT Configuration (for our own API JWTs)
JWT_SECRET=nudgify_super_secret_jwt_key_2026_production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# API Configuration
API_URL=http://localhost:5000
CORS_ORIGIN=*
CORS_ORIGIN_FRONTEND=http://localhost:3000

# Storage Configuration
SUPABASE_STORAGE_BUCKET_CHEFS=chef-images
SUPABASE_STORAGE_BUCKET_DISHES=dish-images
