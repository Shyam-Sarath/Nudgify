# Backend Local Development Environment
# Copy this file to .env.local and fill in your Supabase credentials

NODE_ENV=development
PORT=5000

# Supabase Configuration
# Get these from: https://app.supabase.com > Project Settings > API
SUPABASE_URL=https://ludedzyuwnsurxsmahli.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_from_supabase

# JWT Configuration
JWT_SECRET=super_secret_key_change_me_in_production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# API Configuration
API_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000
CORS_ORIGIN_FRONTEND=http://localhost:3000

# Storage Configuration
SUPABASE_STORAGE_BUCKET_CHEFS=chef-images
SUPABASE_STORAGE_BUCKET_DISHES=dish-images

# Logging
LOG_LEVEL=debug
